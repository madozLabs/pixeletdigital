# Local PostgreSQL connection string. Copy to .env and replace placeholders locally.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pixeldigital?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Domain allowed for employee accounts created from the Workspace.
EMPLOYEE_EMAIL_DOMAIN="pixeldigital.local"
