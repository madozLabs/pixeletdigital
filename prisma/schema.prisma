generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorldMode {
  ACTIVE
  TEASER
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AccessRole {
  SUPER_ADMIN
  ADMIN
  WORLD_MANAGER
  EDITOR
  SALES
  CONTRIBUTOR
  READER
}

enum AssignmentScopeType {
  GLOBAL
  WORLD
}

enum AuditAction {
  ACCESS_USER_CREATED
  ACCESS_USER_ACTIVATED
  ACCESS_USER_DEACTIVATED
  ACCESS_ROLE_ASSIGNED
  ACCESS_ROLE_REVOKED
  CONTENT_PAGE_PUBLISHED
  CONTENT_PAGE_ARCHIVED
  CONTENT_SITE_IDENTITY_PUBLISHED
  CONTENT_SERVICE_PUBLISHED
  CONTENT_SERVICE_ARCHIVED
  BILLING_INVOICE_ISSUED
  BILLING_INVOICE_CANCELLED
  BILLING_PAYMENT_RECORDED
  BILLING_CREDIT_NOTE_ISSUED
  FINANCE_EXPENSE_RECORDED
  FINANCE_EXPENSE_DELETED
  FINANCE_REVENUE_RECORDED
  FINANCE_REVENUE_DELETED
}

enum AuditTargetType {
  USER
  ROLE_ASSIGNMENT
  PAGE
  SITE_SETTINGS
  SERVICE
  INVOICE
  CREDIT_NOTE
  EXPENSE
  REVENUE_ENTRY
}

enum AuditResult {
  SUCCEEDED
}

enum RequestOriginChannel {
  WORKSPACE
  SYSTEM
}

enum AuthenticationEventType {
  SIGN_IN_SUCCEEDED
  SIGN_IN_FAILED
  SIGN_IN_REJECTED
  SIGN_OUT
}

enum AuthenticationFailureReason {
  INVALID_CREDENTIALS
  UNLINKED_IDENTITY
  INACTIVE_USER
  MISSING_ASSIGNMENT
  PROVIDER_ERROR
  SESSION_INVALID
}

enum ContentLifecycleState {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PageRevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum MediaLifecycleState {
  DRAFT
  APPROVED
  ARCHIVED
}

enum MediaProcessingState {
  PENDING
  READY
  REJECTED
}

enum ServiceAvailabilityStatus {
  CANDIDATE
  CURRENT_STATED
  APPROVED_CURRENT
  FUTURE_ONLY
  WITHDRAWN
}

enum EnquiryType {
  GENERAL
}

enum EnquiryAbuseStatus {
  ACCEPTED
  FLAGGED
}

enum LeadStatus {
  NEW
  IN_REVIEW
  QUALIFIED
  UNQUALIFIED
  CLOSED
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  NEXT_ACTION_SET
  NEXT_ACTION_COMPLETED
}

enum NextActionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LeadNoteVisibility {
  INTERNAL
}

enum EditorialItemStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  CANCELLED
}

enum EditorialContentType {
  POST
  STORY
  REEL
  VIDEO
  ARTICLE
  EMAIL
  AD
  OTHER
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CatalogueItemKind {
  SERVICE
  PRODUCT
}

enum CatalogueItemStatus {
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHEQUE
  OTHER
}

model World {
  id                 String              @id @default(cuid())
  key                String              @unique
  displayName        String
  mode               WorldMode
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roleAssignments    RoleAssignment[]
  auditEvents        AuditEvent[]
  projects           Project[]
  pages              Page[]
  services           Service[]
  serviceFamilies    ServiceFamily[]
  enquiries          Enquiry[]
  editorialItems     EditorialItem[]
  clients            Client[]
  catalogueItems     CatalogueItem[]
  quotes             Quote[]
  invoices           Invoice[]
  mediaAssets        MediaAsset[]
  siteSettings       SiteSettings?
  leads              Lead[]
  billingAttachments BillingAttachment[]
  creditNotes        CreditNote[]
  expenses           Expense[]
  revenueEntries     RevenueEntry[]
  comments           Comment[]
  globalComponents   GlobalComponent[]
  pageTemplates      PageTemplate[]

  @@map("worlds")
}

model User {
  id                         String              @id @default(cuid())
  displayName                String?
  normalizedEmail            String?             @unique
  status                     UserStatus
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  authAccounts               AuthAccount[]
  roleAssignments            RoleAssignment[]
  memberships                TeamMembership[]
  managedClients             Client[]            @relation("ClientAccountManager")
  commercialClients          Client[]            @relation("ClientCommercialOwner")
  managedProjects            Project[]           @relation("ProjectManager")
  assignedTasks              Task[]              @relation("TaskAssignee")
  createdTasks               Task[]              @relation("TaskCreator")
  editorialItems             EditorialItem[]     @relation("EditorialOwner")
  reviewedItems              EditorialItem[]     @relation("EditorialReviewer")
  ownedLeads                 Lead[]              @relation("LeadOwner")
  authoredLeadNotes          LeadNote[]          @relation("LeadNoteAuthor")
  ownedNextActions           NextAction[]        @relation("NextActionOwner")
  leadActivities             LeadActivity[]      @relation("LeadActivityActor")
  editPresences              EditPresence[]
  uploadedBillingAttachments BillingAttachment[]
  recordedExpenses           Expense[]
  recordedRevenueEntries     RevenueEntry[]
  postedComments             Comment[]
  commentMentions            CommentMention[]
  notifications              Notification[]

  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teams       Team[]

  @@map("departments")
}

model Team {
  id           String           @id @default(cuid())
  departmentId String
  name         String
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  memberships  TeamMembership[]
  clients      Client[]
  projects     Project[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("teams")
}

model JobPosition {
  id          String           @id @default(cuid())
  title       String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships TeamMembership[]

  @@map("job_positions")
}

model TeamMembership {
  id            String       @id @default(cuid())
  userId        String
  teamId        String
  jobPositionId String?
  isPrimary     Boolean      @default(false)
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  jobPosition   JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: Restrict)

  @@index([userId, endedAt])
  @@index([teamId, endedAt])
  @@index([jobPositionId])
  @@map("team_memberships")
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model RoleAssignment {
  id         String              @id @default(cuid())
  userId     String
  role       AccessRole
  scopeType  AssignmentScopeType
  worldId    String?
  validFrom  DateTime
  validUntil DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  world      World?              @relation(fields: [worldId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom, validUntil])
  @@index([worldId])
  @@map("role_assignments")
}

model AuditEvent {
  id            String               @id
  occurredAt    DateTime
  actorId       String
  action        AuditAction
  targetType    AuditTargetType
  targetId      String
  result        AuditResult
  correlationId String
  originChannel RequestOriginChannel
  worldId       String?
  world         World?               @relation(fields: [worldId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([worldId, occurredAt])
  @@map("audit_events")
}

model AuthenticationEvent {
  id            String                       @id
  occurredAt    DateTime
  type          AuthenticationEventType
  userId        String?
  provider      String?
  reason        AuthenticationFailureReason?
  correlationId String
  originChannel RequestOriginChannel

  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@map("authentication_events")
}

model Page {
  id                  String                @id
  worldKey            String
  world               World                 @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  pageType            String
  pageKind            String                @default("STANDARD")
  templateKey         String                @default("STANDARD")
  routePath           String?
  title               String
  slug                String
  lifecycle           ContentLifecycleState
  version             Int
  publishedAt         DateTime?
  draftRevisionId     String?               @unique
  publishedRevisionId String?               @unique
  serviceId           String?               @unique
  createdAt           DateTime
  updatedAt           DateTime

  revisions         PageRevision[]     @relation("PageRevisions")
  draftRevision     PageRevision?      @relation("PageDraftRevision", fields: [draftRevisionId], references: [id], onDelete: SetNull)
  publishedRevision PageRevision?      @relation("PagePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  editorialItems    EditorialItem[]
  views             PageView[]
  previewShares     PagePreviewShare[]

  @@unique([worldKey, pageType, slug])
  @@unique([worldKey, routePath])
  @@index([worldKey, lifecycle])
  @@index([worldKey, slug, lifecycle])
  @@map("pages")
}

// Grants a named, expiring, unauthenticated preview of one specific
// revision -- for sharing a draft with an external client who has no
// Workspace login. Deliberately scoped to a single revisionId (not "latest
// draft") so the link keeps showing what was actually shared even if the
// draft moves on afterwards.
model PagePreviewShare {
  id          String    @id @default(cuid())
  token       String    @unique
  pageId      String
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  revisionId  String
  label       String?
  createdById String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([pageId])
  @@map("page_preview_shares")
}

// Minimal internal analytics: one row per real public pageview (preview
// mode excluded). Deliberately just pageId+timestamp -- no session,
// referrer, or user-agent tracking, so it stays a lightweight "what's
// getting looked at" signal rather than a GDPR-relevant profile store.
model PageView {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
  @@map("page_views")
}

model PageRevision {
  id                 String             @id
  pageId             String
  page               Page               @relation("PageRevisions", fields: [pageId], references: [id], onDelete: Restrict)
  revisionNumber     Int
  status             PageRevisionStatus
  title              String
  seoTitle           String?
  seoDescription     String?
  ogImageMediaId     String?
  ogImage            MediaAsset?        @relation(fields: [ogImageMediaId], references: [id], onDelete: Restrict)
  version            Int                @default(1)
  createdById        String?
  reviewedById       String?
  publishedById      String?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  snapshotCursor     Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sections          PageRevisionSection[]
  snapshots         PageRevisionSnapshot[]
  draftForPages     Page[]                 @relation("PageDraftRevision")
  publishedForPages Page[]                 @relation("PagePublishedRevision")

  @@unique([pageId, revisionNumber])
  @@index([pageId, status])
  @@index([ogImageMediaId])
  @@index([status, scheduledPublishAt])
  @@map("page_revisions")
}

model PageRevisionSection {
  id                   String       @id
  revisionId           String
  revision             PageRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  sectionKey           String
  sectionType          String
  order                Int
  payload              Json
  payloadSchemaVersion Int
  version              Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Set when this row is an *instance* of a global component -- its own
  // payload is ignored at render time in favor of the component's live
  // (sourceSection) payload. Restrict so a component can't be deleted out
  // from under pages that still reference it (see deleteGlobalComponentAction,
  // which requires detaching every instance first).
  globalComponentId String?
  globalComponent   GlobalComponent? @relation("GlobalComponentInstances", fields: [globalComponentId], references: [id], onDelete: Restrict)

  // Set (via the reverse relation) when this row is the canonical, editable
  // source content of a global component -- i.e. it lives on that world's
  // hidden component-library page. Restrict so the source can't be deleted
  // while the component still exists.
  sourceForComponent GlobalComponent? @relation("GlobalComponentSource")

  mediaUsages SectionMediaUsage[]

  @@unique([revisionId, sectionKey])
  @@index([revisionId, order])
  @@index([globalComponentId])
  @@map("page_revision_sections")
}

// A reusable block: one canonical PageRevisionSection (sourceSection, living
// on a hidden per-world "component library" page) that any number of other
// pages can embed as a lightweight instance. Editing the source through the
// normal page builder updates every instance immediately, since instances
// defer to the source's live payload at render time instead of storing
// their own copy.
model GlobalComponent {
  id              String   @id
  worldKey        String
  world           World    @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  name            String
  sectionType     String
  sourceSectionId String   @unique
  sourceSection   PageRevisionSection @relation("GlobalComponentSource", fields: [sourceSectionId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances PageRevisionSection[] @relation("GlobalComponentInstances")

  @@unique([worldKey, name])
  @@map("global_components")
}

// A reusable starting point for new pages: a snapshot of one revision's
// sections at "save as template" time. Unlike GlobalComponent, this is a
// one-shot copy applied when a page is created -- it does not stay linked
// to whatever page it was captured from, and later edits to that page (or
// to pages created from this template) never propagate either way.
model PageTemplate {
  id        String   @id
  worldKey  String
  world     World    @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  name      String
  sections  Json
  createdAt DateTime @default(now())

  @@unique([worldKey, name])
  @@map("page_templates")
}

model SectionMediaUsage {
  id        String              @id @default(cuid())
  sectionId String
  section   PageRevisionSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  mediaId   String
  media     MediaAsset          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  slot      String
  order     Int                 @default(0)
  createdAt DateTime            @default(now())

  @@unique([sectionId, slot, order])
  @@index([mediaId])
  @@map("section_media_usages")
}

model PageRevisionSnapshot {
  id         String       @id @default(cuid())
  revisionId String
  revision   PageRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sequence   Int
  sections   Json
  createdAt  DateTime     @default(now())

  @@unique([revisionId, sequence])
  @@map("page_revision_snapshots")
}

model PageBlockDeletion {
  id                   String    @id @default(cuid())
  pageId               String
  revisionId           String
  sectionType          String
  order                Int
  payload              Json
  payloadSchemaVersion Int
  mediaUsages          Json
  deletedById          String
  createdAt            DateTime  @default(now())
  restoredAt           DateTime?

  @@index([pageId, revisionId, createdAt])
  @@map("page_block_deletions")
}

model MediaAsset {
  id              String               @id @default(cuid())
  worldKey        String
  world           World                @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  bucket          String
  objectPath      String
  publicUrl       String
  title           String
  altText         String
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  tags            String[]             @default([])
  lifecycle       MediaLifecycleState  @default(DRAFT)
  processingState MediaProcessingState @default(PENDING)
  checksum        String?
  caption         String?
  credit          String?
  rightsStatement String?
  rightsExpiresAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  usages              SectionMediaUsage[]
  siteIdentityUsages  SiteIdentityMediaUsage[]
  ogImageForRevisions PageRevision[]

  @@unique([bucket, objectPath])
  @@index([worldKey, createdAt])
  @@index([worldKey, mimeType])
  @@map("media_assets")
}

enum BillingAttachmentTargetType {
  QUOTE
  INVOICE
  CREDIT_NOTE
}

model BillingAttachment {
  id           String                      @id @default(cuid())
  worldKey     String
  world        World                       @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  targetType   BillingAttachmentTargetType
  targetId     String
  fileName     String
  bucket       String
  objectPath   String
  publicUrl    String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?                       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                    @default(now())

  @@index([targetType, targetId])
  @@map("billing_attachments")
}

model SiteSettings {
  id                  String                 @id
  worldKey            String                 @unique
  world               World                  @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  draftRevisionId     String?                @unique
  publishedRevisionId String?                @unique
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  revisions           SiteSettingsRevision[] @relation("SiteSettingsRevisions")
  draftRevision       SiteSettingsRevision?  @relation("SiteSettingsDraftRevision", fields: [draftRevisionId], references: [id], onDelete: SetNull)
  publishedRevision   SiteSettingsRevision?  @relation("SiteSettingsPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model SiteSettingsRevision {
  id             String                   @id
  settingsId     String
  settings       SiteSettings             @relation("SiteSettingsRevisions", fields: [settingsId], references: [id], onDelete: Restrict)
  revisionNumber Int
  status         PageRevisionStatus
  config         Json
  version        Int                      @default(1)
  createdById    String?
  reviewedById   String?
  publishedById  String?
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  draftFor       SiteSettings[]           @relation("SiteSettingsDraftRevision")
  publishedFor   SiteSettings[]           @relation("SiteSettingsPublishedRevision")
  mediaUsages    SiteIdentityMediaUsage[]

  @@unique([settingsId, revisionNumber])
  @@index([settingsId, status])
  @@map("site_settings_revisions")
}

model SiteIdentityMediaUsage {
  id         String               @id @default(cuid())
  revisionId String
  revision   SiteSettingsRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  mediaId    String
  media      MediaAsset           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  slot       String
  createdAt  DateTime             @default(now())

  @@unique([revisionId, slot])
  @@index([mediaId])
  @@map("site_identity_media_usages")
}

model Service {
  id                 String                    @id
  worldKey           String
  world              World                     @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  familyId           String?
  family             ServiceFamily?            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  name               String
  slug               String
  description        String
  page               Page?
  availabilityStatus ServiceAvailabilityStatus
  lifecycle          ContentLifecycleState
  version            Int
  publishedAt        DateTime?
  createdAt          DateTime
  updatedAt          DateTime
  enquiries          Enquiry[]

  @@unique([worldKey, slug])
  @@index([worldKey, lifecycle])
  @@index([worldKey, availabilityStatus])
  @@index([worldKey, lifecycle, availabilityStatus])
  @@index([worldKey, slug, lifecycle])
  @@index([familyId])
  @@map("services")
}

model Enquiry {
  id             String             @id
  type           EnquiryType
  worldKey       String
  world          World              @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  serviceId      String?
  service        Service?           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  name           String
  email          String
  phone          String?
  message        String
  sourcePage     String
  idempotencyKey String             @unique
  abuseStatus    EnquiryAbuseStatus
  submittedAt    DateTime

  consent  ConsentRecord?
  leadLink LeadEnquiry?

  @@index([worldKey, email, submittedAt])
  @@index([worldKey, submittedAt])
  @@map("enquiries")
}

model ConsentRecord {
  id         String   @id
  enquiryId  String   @unique
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  purposeKey String
  version    Int
  response   Boolean
  source     String
  capturedAt DateTime

  @@map("consent_records")
}

model Lead {
  id            String     @id
  worldKey      String
  world         World      @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  name          String
  email         String
  phone         String?
  source        String
  status        LeadStatus @default(NEW)
  ownerUserId   String?
  owner         User?      @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  closedOutcome String?
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  enquiryLink LeadEnquiry?
  notes       LeadNote[]
  nextActions NextAction[]
  activities  LeadActivity[]

  @@index([worldKey, status])
  @@index([worldKey, email])
  @@index([ownerUserId])
  @@map("leads")
}

model LeadEnquiry {
  id        String   @id
  leadId    String   @unique
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enquiryId String   @unique
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@map("lead_enquiries")
}

model LeadNote {
  id         String             @id
  leadId     String
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User               @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  visibility LeadNoteVisibility @default(INTERNAL)
  createdAt  DateTime           @default(now())

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

model NextAction {
  id          String           @id
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerUserId String
  owner       User             @relation("NextActionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  description String
  dueDate     DateTime
  status      NextActionStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([leadId])
  @@index([ownerUserId, status, dueDate])
  @@map("next_actions")
}

model LeadActivity {
  id         String           @id
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       LeadActivityType
  actorId    String?
  actor      User?            @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  detail     String?
  occurredAt DateTime         @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_activities")
}

model ServiceFamily {
  id          String                @id
  worldKey    String
  world       World                 @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  label       String
  order       Int
  lifecycle   ContentLifecycleState
  version     Int
  publishedAt DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  services    Service[]

  @@index([worldKey, order])
  @@index([worldKey, lifecycle])
  @@map("service_families")
}

model EditorialItem {
  id                 String               @id
  worldKey           String
  clientId           String?
  projectId          String?
  ownerId            String?
  reviewerId         String?
  linkedPageId       String?
  clientLabel        String
  channel            String
  contentType        EditorialContentType @default(POST)
  title              String
  brief              String?
  productionDueAt    DateTime?
  scheduledFor       DateTime
  status             EditorialItemStatus
  internalApprovedAt DateTime?
  clientApprovedAt   DateTime?
  proofUrl           String?
  notes              String?
  statusChangeReason String?
  realizedAt         DateTime?
  version            Int
  createdAt          DateTime
  updatedAt          DateTime
  world              World                @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  client             Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner              User?                @relation("EditorialOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewer           User?                @relation("EditorialReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  linkedPage         Page?                @relation(fields: [linkedPageId], references: [id], onDelete: SetNull)

  @@index([worldKey, scheduledFor])
  @@index([linkedPageId])
  @@index([worldKey, status])
  @@index([clientId, status])
  @@index([projectId])
  @@index([ownerId, status])
  @@map("editorial_items")
}

model Client {
  id                String          @id
  worldKey          String
  world             World           @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  name              String
  legalName         String?
  email             String?
  phone             String?
  address           String?
  website           String?
  logoUrl           String?
  industry          String?
  notes             String?
  accountManagerId  String?
  commercialOwnerId String?
  teamId            String?
  status            ClientStatus
  version           Int
  createdAt         DateTime
  updatedAt         DateTime
  accountManager    User?           @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: Restrict)
  commercialOwner   User?           @relation("ClientCommercialOwner", fields: [commercialOwnerId], references: [id], onDelete: Restrict)
  team              Team?           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  contacts          ClientContact[]
  projects          Project[]
  editorialItems    EditorialItem[]
  quotes            Quote[]
  invoices          Invoice[]

  @@index([worldKey, status])
  @@index([accountManagerId])
  @@index([commercialOwnerId])
  @@index([teamId])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isPrimary])
  @@map("client_contacts")
}

model Project {
  id               String          @id @default(cuid())
  worldKey         String
  clientId         String
  name             String
  description      String?
  status           ProjectStatus   @default(PLANNED)
  priority         ProjectPriority @default(NORMAL)
  projectManagerId String?
  teamId           String?
  budgetCents      Int?
  startDate        DateTime?
  dueDate          DateTime?
  progress         Int             @default(0)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  world            World           @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectManager   User?           @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  team             Team?           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  tasks            Task[]
  editorialItems   EditorialItem[]

  @@index([worldKey, status])
  @@index([clientId, status])
  @@index([projectManagerId])
  @@index([teamId])
  @@index([dueDate])
  @@map("projects")
}

model EditPresence {
  id           String   @id @default(cuid())
  userId       String
  entityType   String
  entityId     String
  contextLabel String?
  // The specific page-builder section (block) this viewer currently has
  // selected, if any -- lets other editors see "someone is on this exact
  // block right now" instead of just "someone is on this page".
  sectionId    String?
  lastSeenAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId, lastSeenAt])
  @@map("edit_presences")
}

model Task {
  id               String       @id @default(cuid())
  projectId        String
  parentTaskId     String?
  dependencyTaskId String?
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(NORMAL)
  assigneeId       String?
  createdById      String?
  dueDate          DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  progress         Int          @default(0)
  position         Int          @default(0)
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask       Task?        @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  subtasks         Task[]       @relation("TaskHierarchy")
  dependencyTask   Task?        @relation("TaskDependency", fields: [dependencyTaskId], references: [id], onDelete: Restrict)
  dependentTasks   Task[]       @relation("TaskDependency")
  assignee         User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy        User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, status, position])
  @@index([assigneeId, status])
  @@index([parentTaskId])
  @@index([dependencyTaskId])
  @@index([dueDate])
  @@map("tasks")
}

model CatalogueItem {
  id             String              @id
  worldKey       String
  world          World               @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  label          String
  kind           CatalogueItemKind
  unitPriceCents Int
  status         CatalogueItemStatus
  version        Int
  createdAt      DateTime
  updatedAt      DateTime

  @@index([worldKey, status])
  @@map("catalogue_items")
}

model Quote {
  id            String      @id @default(cuid())
  worldKey      String
  clientId      String
  number        String
  status        QuoteStatus @default(DRAFT)
  issuedAt      DateTime    @default(now())
  validUntil    DateTime?
  discountCents Int         @default(0)
  taxRateBps    Int         @default(0)
  notes         String?
  convertedAt   DateTime?
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  world         World       @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines         QuoteLine[]
  invoice       Invoice?

  @@unique([worldKey, number])
  @@index([worldKey, status])
  @@index([clientId, status])
  @@map("quotes")
}

model QuoteLine {
  id             String @id @default(cuid())
  quoteId        String
  label          String
  quantity       Int
  unitPriceCents Int
  order          Int
  quote          Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, order])
  @@map("quote_lines")
}

model Invoice {
  id            String        @id
  worldKey      String
  clientId      String
  quoteId       String?       @unique
  number        String
  status        InvoiceStatus
  issuedAt      DateTime
  dueAt         DateTime?
  discountCents Int           @default(0)
  taxRateBps    Int           @default(0)
  notes         String?
  paidAt        DateTime?
  version       Int
  createdAt     DateTime
  updatedAt     DateTime
  world         World         @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quote         Quote?        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  payments      Payment[]
  creditNotes   CreditNote[]

  @@unique([worldKey, number])
  @@index([worldKey, status])
  @@index([clientId, status])
  @@index([dueAt])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label          String
  quantity       Int
  unitPriceCents Int
  order          Int

  @@index([invoiceId, order])
  @@map("invoice_lines")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amountCents Int
  method      PaymentMethod
  paidAt      DateTime      @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, paidAt])
  @@map("payments")
}

// Append-only ledger, mirroring Payment: a credit note is never edited or
// deleted once issued, only ever created. The invoice's credited total is
// derived by summing this table (same pattern as Payment/totalPaidCents),
// not stored redundantly on Invoice.
model CreditNote {
  id         String           @id
  worldKey   String
  invoiceId  String
  number     String
  reason     String
  notes      String?
  taxRateBps Int              @default(0)
  issuedAt   DateTime
  createdAt  DateTime
  world      World            @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  invoice    Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lines      CreditNoteLine[]

  @@unique([worldKey, number])
  @@index([invoiceId])
  @@index([worldKey, issuedAt])
  @@map("credit_notes")
}

model CreditNoteLine {
  id             String     @id
  creditNoteId   String
  creditNote     CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  label          String
  quantity       Int
  unitPriceCents Int
  order          Int

  @@index([creditNoteId, order])
  @@map("credit_note_lines")
}

enum ExpenseCategoryStatus {
  ACTIVE
  ARCHIVED
}

// A shared chart-of-accounts-style taxonomy, not scoped per world: "Loyer"
// means the same thing whether the cost belongs to Pixel&Digital or Kwaliti
// Print -- the Expense row itself carries worldKey for per-instance
// reporting, so duplicating the category list per world would only add
// upkeep without separating anything real.
model ExpenseCategory {
  id        String                @id
  label     String
  status    ExpenseCategoryStatus
  version   Int
  createdAt DateTime
  updatedAt DateTime
  expenses  Expense[]

  @@unique([label])
  @@map("expense_categories")
}

// Manual ledger entry, not a legal document like Invoice/CreditNote -- no
// version/lifecycle, only create and delete (a mistake is deleted and
// re-entered rather than amended in place).
model Expense {
  id          String          @id
  worldKey    String
  categoryId  String
  label       String
  amountCents Int
  expenseDate DateTime
  notes       String?
  createdById String?
  createdAt   DateTime
  world       World           @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([worldKey, expenseDate])
  @@index([categoryId])
  @@map("expenses")
}

// Revenue received outside the Quote/Invoice pipeline (e.g. a cash sale) --
// same append-only, create/delete-only shape as Expense; no category, the
// report groups these under a single "Recettes hors facture" bucket.
model RevenueEntry {
  id          String   @id
  worldKey    String
  label       String
  amountCents Int
  revenueDate DateTime
  notes       String?
  createdById String?
  createdAt   DateTime
  world       World    @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([worldKey, revenueDate])
  @@map("revenue_entries")
}

enum NotificationType {
  MENTIONED
  REVIEW_REQUESTED
}

// entityType/entityId is a loose polymorphic reference (no FK), matching
// the same pattern already used by EditPresence/AuditEvent/BillingAttachment
// in this codebase rather than a Prisma union type (which doesn't exist) or
// one nullable FK column per attachable model (which doesn't scale as new
// entity types are added). Valid values are enforced in the domain layer,
// not the database.
model Comment {
  id            String           @id
  entityType    String
  entityId      String
  worldKey      String
  authorId      String
  body          String
  createdAt     DateTime
  world         World            @relation(fields: [worldKey], references: [key], onDelete: Restrict)
  author        User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions      CommentMention[]
  notifications Notification[]

  @@index([entityType, entityId, createdAt])
  @@index([worldKey])
  @@map("comments")
}

model CommentMention {
  id              String   @id
  commentId       String
  mentionedUserId String
  createdAt       DateTime
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser   User     @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("comment_mentions")
}

// One row per mentioned recipient, not per comment -- @mentioning three
// people in one comment must notify all three independently (each with
// their own read state), not collapse into a single shared notification.
model Notification {
  id         String           @id
  userId     String
  type       NotificationType
  commentId  String?
  entityType String
  entityId   String
  worldKey   String
  readAt     DateTime?
  createdAt  DateTime
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment    Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
